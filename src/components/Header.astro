---
import { Image } from 'astro:assets';
import logoHybrid from '../assets/logo-hybrid.png';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#top" class="brand-link" aria-label="HYBRID Electro Mechanical L.L.C Home">
      <Image
        src={logoHybrid}
        alt="HYBRID Electro Mechanical L.L.C"
        class="brand-logo"
        width={180}
        height={43}
        loading="eager"
      />
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Primary Navigation">
      <span class="nav-hover-pill" id="nav-hover-pill" aria-hidden="true"></span>
      <a href="#about" class="nav-link" data-nav="about">About Us</a>
      <a href="#services" class="nav-link" data-nav="services">Services</a>
      <a href="#stats" class="nav-link" data-nav="stats">Track Record</a>
      <a href="#projects" class="nav-link" data-nav="projects">Projects</a>
      <a href="#contact" class="nav-link" data-nav="contact">Contact</a>
    </nav>

    <div class="header-actions">
      <a href="#contact" class="btn-pill btn-pill-dark">
        <span>Contact Us</span>
        <span class="btn-icon-circle" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12L12 4M6 4h6v6"/>
          </svg>
        </span>
      </a>
      <button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Toggle navigation menu">
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line line-1"></span>
          <span class="hamburger-line line-2"></span>
          <span class="hamburger-line line-3"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-nav" aria-label="Mobile Navigation">
      <a href="#about" class="mobile-nav-link">About Us</a>
      <a href="#services" class="mobile-nav-link">Services</a>
      <a href="#stats" class="mobile-nav-link">Track Record</a>
      <a href="#projects" class="mobile-nav-link">Projects</a>
      <a href="#contact" class="mobile-nav-link">Contact Us</a>
    </nav>
  </div>
</header>
