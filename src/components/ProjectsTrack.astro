---
import { Image } from 'astro:assets';
import { projectsData } from '../data/projects';
import type { ImageMetadata } from 'astro';

import imgGemsCambridge from '../assets/projects/gems-cambridge-1.jpg';
import imgMasdarAirdome from '../assets/projects/masdar-airdome-1.jpg';
import imgHudayriyatPadel from '../assets/projects/hudayriyat-padel-3.jpg';
import imgZayedCommercial from '../assets/projects/zayed-commercial-1.jpg';
import imgAlRefaaaPark from '../assets/projects/al-refaaa-park-1.jpg';
import imgMirdiffSports from '../assets/projects/mirdiff-sports-2.jpg';
import imgGemsDaa from '../assets/projects/gems-daa-1.jpg';

const projectImages: Record<string, ImageMetadata> = {
  education: imgGemsCambridge,
  residential: imgMasdarAirdome,
  corporate: imgHudayriyatPadel,
  retail: imgZayedCommercial,
  hospitality: imgAlRefaaaPark,
  healthcare: imgMirdiffSports,
  gemsDaa: imgGemsDaa
};

const projects = Object.values(projectsData);
const infiniteProjects = [
  ...projects.map((p) => ({ ...p, isClone: false })),
  ...projects.map((p) => ({ ...p, isClone: true }))
];
---

<section id="projects" class="projects-section pattern-surface" data-theme="light">
  <div class="container">
    <div class="section-header-row reveal-fade-up">
      <h2>Selected Project Sectors &amp; Scopes</h2>
      <div class="carousel-controls" aria-label="Projects Gallery Controls">
        <button type="button" class="carousel-btn" id="proj-prev" aria-label="Previous projects">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 12L6 8l4-4"/>
          </svg>
        </button>
        <button type="button" class="carousel-btn" id="proj-next" aria-label="Next projects">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 12l4-4-4-4"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="projects-track-wrapper reveal-fade-up">
    <div class="projects-track" id="projects-track" tabindex="0" aria-label="Projects showcase carousel">
      {infiniteProjects.map((proj) => (
        <article
          class="project-card spotlight-card"
          tabindex={proj.isClone ? -1 : 0}
          aria-hidden={proj.isClone ? 'true' : undefined}
          data-project-id={proj.id}
        >
          <div class="project-card-image-wrap">
            <Image
              src={projectImages[proj.id]}
              alt={`${proj.title} - Client: ${proj.client}`}
              class="project-card-photo"
              width={800}
              height={533}
              loading="lazy"
            />
            <div class="project-card-badge-top">
              <span class="project-sector-badge">Client: {proj.client}</span>
            </div>
          </div>

          <div class="project-card-body">
            <div class="project-card-text">
              <h3>{proj.title}</h3>
              <p>Client: {proj.client}</p>
            </div>

            <div class="project-card-action">
              <span class="project-view-btn">
                <span>View Project</span>
                <span class="btn-icon-circle-sm" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12L12 4M6 4h6v6"/>
                  </svg>
                </span>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
