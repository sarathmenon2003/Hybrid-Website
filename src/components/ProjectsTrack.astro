---
import { Image } from 'astro:assets';
import { projectsData } from '../data/projects';
import type { ImageMetadata } from 'astro';

import imgResidential from '../assets/projects/project-residential.jpg';
import imgCorporate from '../assets/projects/project-corporate.jpg';
import imgRetail from '../assets/projects/project-retail.jpg';
import imgHospitality from '../assets/projects/project-hospitality.jpg';
import imgHealthcare from '../assets/projects/project-healthcare.jpg';
import imgEducation from '../assets/projects/project-education.jpg';

const projectImages: Record<string, ImageMetadata> = {
  residential: imgResidential,
  corporate: imgCorporate,
  retail: imgRetail,
  hospitality: imgHospitality,
  healthcare: imgHealthcare,
  education: imgEducation
};

const projects = Object.values(projectsData);
---

<section id="projects" class="projects-section pattern-surface" data-theme="light">
  <div class="container">
    <div class="section-header-row reveal-fade-up">
      <h2>Selected Project Sectors &amp; Scopes</h2>
      <div class="carousel-controls" aria-label="Projects Gallery Controls">
        <button type="button" class="carousel-btn" id="proj-prev" aria-label="Previous projects">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 12L6 8l4-4"/>
          </svg>
        </button>
        <button type="button" class="carousel-btn" id="proj-next" aria-label="Next projects">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 12l4-4-4-4"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="projects-track-wrapper">
      <div class="projects-track reveal-stagger" id="projects-track" tabindex="0" aria-label="Projects showcase carousel">
        {projects.map((proj) => (
          <article class="project-card spotlight-card" tabindex="0" data-project-id={proj.id}>
            <div class="project-card-image-wrap">
              <Image
                src={projectImages[proj.id]}
                alt={`${proj.title} - ${proj.sector}`}
                class="project-card-photo"
                width={800}
                height={533}
                loading="lazy"
              />
              <div class="project-card-badge-top">
                <span class="project-sector-badge">{proj.sector}</span>
              </div>
            </div>

            <div class="project-card-body">
              <div class="project-card-text">
                <h3>{proj.title}</h3>
                <p>
                  {proj.id === 'residential' && 'Turnkey MEP engineering, high-durability distribution networks, and smart home automation.'}
                  {proj.id === 'corporate' && 'Turnkey commercial fit-out, submittals, and multi-zone climate control.'}
                  {proj.id === 'retail' && 'Fast-track mall authority approvals, architectural lighting, and package AC units.'}
                  {proj.id === 'hospitality' && 'Low-noise chilled water systems, smart room controls, and luxury plumbing fixtures.'}
                  {proj.id === 'healthcare' && 'Hygienic ventilation, essential LV standby power, and medical-grade drainage lines.'}
                  {proj.id === 'education' && 'Campus structured cabling, central cooling plants, and high-capacity water networks.'}
                </p>
              </div>

              <div class="project-card-action">
                <span class="project-view-btn">
                  <span>View Project</span>
                  <span class="btn-icon-circle-sm" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 12L12 4M6 4h6v6"/>
                    </svg>
                  </span>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
