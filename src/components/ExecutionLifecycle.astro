---
---

<div class="cycle-block">
  <div class="cycle-header reveal-fade-up">
    <h3>Turnkey MEP Execution Lifecycle</h3>
    <div class="cycle-pills" role="tablist" aria-label="Execution Lifecycle Stages">
      <button type="button" class="cycle-tab is-active" role="tab" aria-selected="true" data-stage="all">All Phases</button>
      <button type="button" class="cycle-tab" role="tab" aria-selected="false" data-stage="engineering">Engineering &amp; Submittals</button>
      <button type="button" class="cycle-tab" role="tab" aria-selected="false" data-stage="installation">Site Installation</button>
      <button type="button" class="cycle-tab" role="tab" aria-selected="false" data-stage="commissioning">Testing &amp; Handover</button>
    </div>
  </div>

  <div class="cycle-steps-grid reveal-stagger">
    <div class="cycle-step-card spotlight-card" data-stage-item="engineering">
      <div class="cycle-step-top">
        <span class="cycle-step-badge">Phase 01</span>
        <div class="cycle-step-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
            <rect x="6" y="4" width="22" height="30" rx="3" stroke="#0d0f18" stroke-width="2.2"/>
            <path d="M12 12h10M12 18h10M12 24h6" stroke="#4b53a4" stroke-width="2.2" stroke-linecap="round"/>
            <circle cx="28" cy="28" r="7" fill="#f4f5fa" stroke="#4b53a4" stroke-width="2.2"/>
            <path d="M25.5 28l1.8 1.8 3.5-3.6" stroke="#0d0f18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <h4>Shop &amp; Coordination Drawings</h4>
      <p>Complete technical documentation, material submittals, and multi-discipline MEP clash coordination.</p>
    </div>

    <div class="cycle-step-card spotlight-card" data-stage-item="engineering">
      <div class="cycle-step-top">
        <span class="cycle-step-badge">Phase 02</span>
        <div class="cycle-step-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
            <path d="M20 4L33 9v10c0 9.2-5.6 15.6-13 18-7.4-2.4-13-8.8-13-18V9l13-5z" stroke="#0d0f18" stroke-width="2.2" stroke-linejoin="round"/>
            <path d="M14.5 20.5l3.8 3.8 7.5-7.8" stroke="#4b53a4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <h4>Authority Approvals</h4>
      <p>Direct liaison and compliance verification with UAE utility authorities and project consultants.</p>
    </div>

    <div class="cycle-step-card spotlight-card" data-stage-item="installation">
      <div class="cycle-step-top">
        <span class="cycle-step-badge">Phase 03</span>
        <div class="cycle-step-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
            <rect x="5" y="7" width="12" height="12" rx="2" stroke="#0d0f18" stroke-width="2.2"/>
            <rect x="23" y="7" width="12" height="12" rx="2" stroke="#4b53a4" stroke-width="2.2"/>
            <rect x="5" y="23" width="12" height="12" rx="2" stroke="#4b53a4" stroke-width="2.2"/>
            <rect x="23" y="23" width="12" height="12" rx="2" stroke="#0d0f18" stroke-width="2.2"/>
            <path d="M17 13h6M17 29h6M11 19v4M29 19v4" stroke="#4b53a4" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
      <h4>Supply &amp; Site Installation</h4>
      <p>Streamlined procurement and supervised installation across LV electrical, HVAC, plumbing, and ELV systems.</p>
    </div>

    <div class="cycle-step-card spotlight-card" data-stage-item="commissioning">
      <div class="cycle-step-top">
        <span class="cycle-step-badge">Phase 04</span>
        <div class="cycle-step-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
            <rect x="4" y="8" width="32" height="24" rx="3" stroke="#0d0f18" stroke-width="2.2"/>
            <path d="M9 21h5l3-7 5 12 3-5h6" stroke="#4b53a4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <h4>Commissioning &amp; As-Built</h4>
      <p>Rigorous load testing, start-up, as-built documentation, and ongoing preventive maintenance.</p>
    </div>
  </div>
</div>
