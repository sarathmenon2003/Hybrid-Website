---
import { Image } from 'astro:assets';
import ExecutionLifecycle from './ExecutionLifecycle.astro';
import serviceElectrical from '../assets/service-electrical-cutout.png';
import serviceLowCurrent from '../assets/service-lowcurrent-cutout.png';
import servicePlumbing from '../assets/service-plumbing-cutout.png';
import serviceHvac from '../assets/service-hvac-cutout.png';

const services = [
  {
    id: 'electrical',
    title: 'Electrical Services',
    summary: 'Safe, code-compliant Low Voltage power distribution, switchgear assembly, and lighting infrastructure.',
    image: serviceElectrical,
    imageAlt: 'HYBRID technicians on ladders servicing low-voltage electrical distribution boards and control panels',
    width: 1200,
    height: 1061,
    icon: 'electrical'
  },
  {
    id: 'low-current',
    title: 'Low Current Systems',
    summary: 'Structured data cabling, enterprise security monitoring, and intelligent building automation networks.',
    image: serviceLowCurrent,
    imageAlt: 'HYBRID engineer configuring low-current structured cabling, server racks, and data center patch panels',
    width: 1200,
    height: 1022,
    icon: 'low-current'
  },
  {
    id: 'plumbing',
    title: 'Plumbing & Sanitary',
    summary: 'Water supply piping, sanitary drainage networks, booster pumping stations, and rainwater systems.',
    image: servicePlumbing,
    imageAlt: 'HYBRID plumbing team installing and testing green polypropylene water distribution manifolds and pressure valves',
    width: 1200,
    height: 1025,
    icon: 'plumbing'
  },
  {
    id: 'hvac',
    title: 'HVAC & Air Conditioning',
    summary: 'Central chiller systems, precision ventilation, insulated duct fabrication, and energy-efficient cooling.',
    image: serviceHvac,
    imageAlt: 'HYBRID HVAC technicians inspecting and servicing industrial rooftop air handling units and chiller coils',
    width: 1091,
    height: 1199,
    icon: 'hvac'
  }
];
---

<section id="services" class="services-section pattern-surface" data-theme="light">
  <div class="container">
    <div class="section-header-row reveal-fade-up">
      <div class="services-header-text">
        <h2>Our Services</h2>
      </div>
      <div class="services-header-actions">
        <a href="#contact" class="inline-arrow-link">
          <span>Request Technical Submittal</span>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12L12 4M6 4h6v6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 2x2 Signature Architectural Bento Grid -->
    <div class="services-bento-grid reveal-stagger">
      {services.map((svc) => (
        <article class="service-bento-card spotlight-card" id={`svc-${svc.id}`}>
          <div class="service-bento-content">
            <div>
              <div class="service-bento-title-row">
                <span class="service-icon-box" aria-hidden="true">
                  {svc.icon === 'electrical' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                  )}
                  {svc.icon === 'low-current' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                      <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                      <line x1="6" y1="6" x2="6.01" y2="6"/>
                      <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                  )}
                  {svc.icon === 'plumbing' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2v6m0 0l-3 3m3-3l3 3M6 14a6 6 0 0 0 12 0c0-4-6-10-6-10s-6 6-6 10z"/>
                    </svg>
                  )}
                  {svc.icon === 'hvac' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>
                    </svg>
                  )}
                </span>
                <h3>{svc.title}</h3>
              </div>

              <p class="service-bento-summary">{svc.summary}</p>
            </div>

            <div class="service-bento-footer">
              <a href="#contact" class="btn-pill-sm-link" aria-label={`Inquire about ${svc.title}`}>
                <span>Inquire Division</span>
                <span class="btn-icon-circle-sm" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12L12 4M6 4h6v6"/>
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <div class="service-bento-visual">
            <Image
              src={svc.image}
              alt={svc.imageAlt}
              class="service-bento-photo"
              width={svc.width}
              height={svc.height}
              loading="lazy"
            />
          </div>
        </article>
      ))}
    </div>

    <!-- Turnkey Execution Cycle (BAU CARGO style interactive capability pills) -->
    <ExecutionLifecycle />
  </div>
</section>
