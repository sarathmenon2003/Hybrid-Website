---
const stats = [
  { target: 200, suffix: '+', label: 'Projects Completed' },
  { target: 30, suffix: '+', label: 'Corporate Clients' },
  { target: 5, suffix: '+', label: 'Years of Experience' },
  { target: 98, suffix: '%', label: 'Client Satisfaction Rate' }
];
---

<section id="stats" class="stats-section pattern-surface" data-theme="blue">
  <div class="container">
    <div class="stats-header">
      <h2>Proven Delivery Across the Emirates</h2>
      <p>Milestones verified across residential, commercial, retail, hospitality, healthcare, and education facilities.</p>
    </div>

    <div class="stats-tiles-grid">
      {stats.map((stat) => (
        <div class="stat-tile">
          <div class="stat-value">
            <span class="js-counter" data-target={stat.target}>{stat.target}</span><span class="stat-suffix">{stat.suffix}</span>
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
