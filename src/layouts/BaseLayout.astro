---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HYBRID Electro Mechanical L.L.C | Engineering Excellence in the UAE',
  description = 'Specialized MEP contracting company in Dubai, UAE delivering electrical, low current, plumbing, and HVAC engineering solutions across residential, retail, and commercial projects.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/logo-hybrid.png" />
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body id="top">
  <slot />
  <script src="../scripts/main.ts"></script>
</body>
</html>
